{"remainingRequest":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/src/components/user/WorkspaceSection.vue?vue&type=script&lang=js&","dependencies":[{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/src/components/user/WorkspaceSection.vue","mtime":1782712726654},{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/babel-loader/lib/index.js","mtime":499162500000},{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["WorkspaceSection.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AA4KA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"WorkspaceSection.vue","sourceRoot":"src/components/user","sourcesContent":["<template>\n  <div class=\"ws-node\" :class=\"`depth-${depth}`\">\n\n    <!-- === CONTAINER: LayoutSection / AccordionGroup / AggregationAccordion === -->\n    <template v-if=\"isContainer\">\n      <div\n        class=\"section-header\"\n        :class=\"[`type-${item.component}`]\"\n        @click=\"expanded = !expanded\"\n      >\n        <span class=\"toggle-arrow\" :class=\"{ expanded }\">▶</span>\n\n        <!-- Editable display name -->\n        <input\n          v-if=\"editingName\"\n          ref=\"nameInput\"\n          v-model=\"nameDraft\"\n          class=\"name-edit-input\"\n          @blur=\"commitName\"\n          @keyup.enter=\"commitName\"\n          @keyup.escape=\"editingName = false\"\n          @click.stop\n        />\n        <span\n          v-else\n          class=\"section-name\"\n          :title=\"hasDisplayName ? 'Double-click to rename' : ''\"\n          @dblclick.stop=\"startEditName\"\n        >{{ sectionLabel }}</span>\n\n        <span class=\"component-pill\">{{ item.component }}</span>\n\n        <!-- Toggles -->\n        <div class=\"section-toggles\" @click.stop>\n          <label v-if=\"'collapsed' in item\" class=\"toggle-label\">\n            <input type=\"checkbox\" :checked=\"item.collapsed\" @change=\"setField('collapsed', $event.target.checked)\" />\n            starts collapsed\n          </label>\n          <label v-if=\"'collapsible' in item\" class=\"toggle-label\">\n            <input type=\"checkbox\" :checked=\"item.collapsible\" @change=\"setField('collapsible', $event.target.checked)\" />\n            collapsible\n          </label>\n          <label v-if=\"'collapsedByDefault' in item\" class=\"toggle-label\">\n            <input type=\"checkbox\" :checked=\"item.collapsedByDefault\" @change=\"setField('collapsedByDefault', $event.target.checked)\" />\n            collapsed by default\n          </label>\n        </div>\n      </div>\n\n      <div v-if=\"expanded\" class=\"section-children\">\n        <workspace-section\n          v-for=\"(child, idx) in (item.contents || [])\"\n          :key=\"idx\"\n          :item=\"child\"\n          :path=\"[...path, 'contents', idx]\"\n          :depth=\"depth + 1\"\n        />\n      </div>\n    </template>\n\n    <!-- === LEAF COMPONENTS === -->\n    <template v-else>\n      <div class=\"leaf-row\" :class=\"`leaf-${item.component}`\">\n\n        <!-- ValidationMessage -->\n        <template v-if=\"item.component === 'ValidationMessage'\">\n          <span class=\"leaf-badge validation\">⚠ Validation</span>\n          <span class=\"leaf-detail\">rule: <code>{{ item.ruleName }}</code></span>\n        </template>\n\n        <!-- FlexDropdown -->\n        <template v-else-if=\"item.component === 'FlexDropdown'\">\n          <span class=\"leaf-badge dropdown\">⬇ Dropdown</span>\n          <div class=\"leaf-fields\">\n            <div class=\"field-row\">\n              <span class=\"field-key\">Label</span>\n              <input\n                :value=\"item.label\"\n                class=\"field-input\"\n                placeholder=\"(none)\"\n                @change=\"setField('label', $event.target.value)\"\n              />\n            </div>\n            <div class=\"field-row\">\n              <span class=\"field-key\">Dimension</span>\n              <code class=\"field-code\">{{ item.dim }}</code>\n            </div>\n            <div class=\"field-row field-row--top\">\n              <span class=\"field-key\">Options<br/><small>(one per line)</small></span>\n              <textarea\n                :value=\"(item.options || []).join('\\n')\"\n                class=\"options-textarea\"\n                rows=\"4\"\n                @change=\"setOptions($event.target.value)\"\n              />\n            </div>\n          </div>\n        </template>\n\n        <!-- ModalSelector -->\n        <template v-else-if=\"item.component === 'ModalSelector'\">\n          <span class=\"leaf-badge modal\">◉ Modal Selector</span>\n          <div class=\"leaf-fields\">\n            <div class=\"field-row\">\n              <span class=\"field-key\">Label</span>\n              <input\n                :value=\"item.label\"\n                class=\"field-input\"\n                placeholder=\"(none)\"\n                @change=\"setField('label', $event.target.value)\"\n              />\n            </div>\n            <div class=\"field-row\">\n              <span class=\"field-key\">Dimension</span>\n              <code class=\"field-code\">{{ item.dim }}</code>\n            </div>\n          </div>\n        </template>\n\n        <!-- StratificationToggle -->\n        <template v-else-if=\"item.component === 'StratificationToggle'\">\n          <span class=\"leaf-badge strat\">⇄ Strat Toggle</span>\n          <div class=\"leaf-fields\">\n            <div class=\"field-row\">\n              <span class=\"field-key\">Dimension</span>\n              <code class=\"field-code\">{{ item.dim }}</code>\n            </div>\n            <div v-if=\"item.hide\" class=\"field-row\">\n              <span class=\"field-key\">Hide when</span>\n              <input\n                :value=\"item.hide\"\n                class=\"field-input field-input--mono\"\n                @change=\"setField('hide', $event.target.value)\"\n              />\n            </div>\n          </div>\n        </template>\n\n        <!-- StratificationDropdown -->\n        <template v-else-if=\"item.component === 'StratificationDropdown'\">\n          <span class=\"leaf-badge strat\">⬇ Strat Dropdown</span>\n          <div class=\"leaf-fields\">\n            <div class=\"field-row\">\n              <span class=\"field-key\">Display Name</span>\n              <input\n                :value=\"item.displayName\"\n                class=\"field-input\"\n                @change=\"setField('displayName', $event.target.value)\"\n              />\n            </div>\n            <div v-if=\"item.options\" class=\"field-row\">\n              <span class=\"field-key\">Options</span>\n              <span class=\"field-tags\">\n                <code v-for=\"opt in item.options\" :key=\"opt\" class=\"tag\">{{ opt }}</code>\n              </span>\n            </div>\n          </div>\n        </template>\n\n        <!-- Generic leaf -->\n        <template v-else>\n          <span class=\"leaf-badge generic\">{{ item.component || '?' }}</span>\n          <span v-if=\"item.dim\" class=\"leaf-detail\">dim: <code>{{ item.dim }}</code></span>\n          <span v-if=\"item.displayName\" class=\"leaf-detail\">{{ item.displayName }}</span>\n        </template>\n\n      </div>\n    </template>\n  </div>\n</template>\n\n<script>\nconst CONTAINERS = [\"LayoutSection\", \"AccordionGroup\", \"AggregationAccordion\", \"StratificationModalBracketSelector\"];\n\nexport default {\n  name: \"WorkspaceSection\",\n  props: {\n    item:  { type: Object, required: true },\n    path:  { type: Array,  required: true },\n    depth: { type: Number, default: 0 },\n  },\n  data() {\n    return {\n      expanded:    this.depth < 2,\n      editingName: false,\n      nameDraft:   \"\",\n    };\n  },\n  computed: {\n    isContainer() {\n      return CONTAINERS.includes(this.item.component) && Array.isArray(this.item.contents);\n    },\n    sectionLabel() {\n      return this.item.displayName || this.item.groupName || this.item.title || this.item.component || \"?\";\n    },\n    hasDisplayName() {\n      return \"displayName\" in this.item || \"groupName\" in this.item;\n    },\n  },\n  methods: {\n    setField(key, value) {\n      this.$store.commit(\"SET_VALUE\", { path: [...this.path, key], value });\n    },\n    setOptions(text) {\n      const opts = text.split(\"\\n\").map(s => s.trim()).filter(Boolean);\n      this.setField(\"options\", opts);\n    },\n    startEditName() {\n      if (!this.hasDisplayName) return;\n      this.nameDraft = this.item.displayName ?? this.item.groupName ?? \"\";\n      this.editingName = true;\n      this.$nextTick(() => this.$refs.nameInput?.focus());\n    },\n    commitName() {\n      const trimmed = this.nameDraft.trim();\n      if (trimmed) {\n        const key = \"displayName\" in this.item ? \"displayName\" : \"groupName\";\n        this.setField(key, trimmed);\n      }\n      this.editingName = false;\n    },\n  },\n};\n</script>\n\n<style scoped>\n.ws-node { font-size: 13px; }\n\n/* === Container === */\n.section-header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 12px;\n  border-radius: 6px;\n  cursor: pointer;\n  user-select: none;\n  transition: background 0.1s;\n}\n\n.depth-0 > .section-header {\n  background: #fff;\n  border: 1px solid #e5e7eb;\n  border-radius: 8px;\n  margin-bottom: 4px;\n  font-weight: 600;\n  font-size: 14px;\n}\n.depth-0 > .section-header:hover { border-color: #c7d2fe; }\n\n.depth-1 > .section-header {\n  background: #f9fafb;\n  border: 1px solid #f0f0f0;\n  margin: 2px 0;\n}\n.depth-1 > .section-header:hover { background: #f0f4ff; }\n\n.depth-2 > .section-header, .depth-3 > .section-header {\n  background: #f9f9f9;\n  padding: 7px 10px;\n}\n.depth-2 > .section-header:hover, .depth-3 > .section-header:hover { background: #eff6ff; }\n\n.toggle-arrow {\n  font-size: 9px;\n  color: #9ca3af;\n  transition: transform 0.15s;\n  flex-shrink: 0;\n}\n.toggle-arrow.expanded { transform: rotate(90deg); }\n\n.section-name {\n  flex: 1;\n  min-width: 0;\n}\n.section-name[title] { cursor: text; }\n\n.name-edit-input {\n  flex: 1;\n  border: 1px solid #6366f1;\n  border-radius: 4px;\n  padding: 2px 6px;\n  font-size: inherit;\n  font-weight: inherit;\n  background: #fff;\n}\n\n.component-pill {\n  font-size: 10px;\n  background: #f3f4f6;\n  color: #6b7280;\n  padding: 2px 7px;\n  border-radius: 10px;\n  font-family: monospace;\n  flex-shrink: 0;\n}\n\n.section-toggles {\n  display: flex;\n  gap: 12px;\n  flex-shrink: 0;\n}\n.toggle-label {\n  display: flex;\n  align-items: center;\n  gap: 4px;\n  font-size: 11px;\n  color: #6b7280;\n  font-weight: 400;\n  cursor: pointer;\n}\n\n.section-children {\n  padding-left: 20px;\n  border-left: 2px solid #f0f0f0;\n  margin-left: 9px;\n  margin-bottom: 6px;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  padding-top: 4px;\n}\n\n/* === Leaf === */\n.leaf-row {\n  display: flex;\n  align-items: flex-start;\n  gap: 10px;\n  padding: 8px 10px;\n  border-radius: 6px;\n  background: #fff;\n  border: 1px solid #f3f4f6;\n}\n.leaf-row:hover { border-color: #e5e7eb; }\n\n.leaf-badge {\n  font-size: 10px;\n  font-weight: 600;\n  padding: 3px 8px;\n  border-radius: 10px;\n  white-space: nowrap;\n  flex-shrink: 0;\n  margin-top: 1px;\n}\n.leaf-badge.validation { background: #fef3c7; color: #92400e; }\n.leaf-badge.dropdown   { background: #ede9fe; color: #5b21b6; }\n.leaf-badge.modal      { background: #d1fae5; color: #065f46; }\n.leaf-badge.strat      { background: #dbeafe; color: #1e40af; }\n.leaf-badge.generic    { background: #f3f4f6; color: #374151; font-family: monospace; }\n\n.leaf-detail { font-size: 12px; color: #6b7280; }\n\n.leaf-fields {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  flex: 1;\n  min-width: 0;\n}\n\n.field-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 12px;\n}\n.field-row--top { align-items: flex-start; }\n\n.field-key {\n  color: #6b7280;\n  width: 90px;\n  flex-shrink: 0;\n  font-size: 11px;\n  line-height: 1.4;\n}\n\n.field-input {\n  flex: 1;\n  border: 1px solid #e5e7eb;\n  border-radius: 4px;\n  padding: 3px 7px;\n  font-size: 12px;\n  background: #fff;\n}\n.field-input:focus { border-color: #6366f1; }\n.field-input--mono { font-family: monospace; font-size: 11px; }\n\n.field-code {\n  background: #f3f4f6;\n  padding: 2px 6px;\n  border-radius: 4px;\n  font-size: 11px;\n  color: #374151;\n}\n\n.options-textarea {\n  flex: 1;\n  border: 1px solid #e5e7eb;\n  border-radius: 4px;\n  padding: 5px 7px;\n  font-size: 11px;\n  font-family: monospace;\n  resize: vertical;\n  background: #fff;\n  min-height: 64px;\n}\n.options-textarea:focus { border-color: #6366f1; }\n\n.field-tags { display: flex; flex-wrap: wrap; gap: 4px; }\n.tag {\n  background: #f3f4f6;\n  padding: 1px 6px;\n  border-radius: 10px;\n  font-size: 10px;\n  color: #374151;\n}\n</style>\n"]}]}
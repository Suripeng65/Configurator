{"remainingRequest":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/src/components/TreeNode.vue?vue&type=style&index=0&id=18eb56f0&scoped=true&lang=css&","dependencies":[{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/src/components/TreeNode.vue","mtime":1782688741437},{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/css-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/vue-loader/lib/loaders/stylePostLoader.js","mtime":499162500000},{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/postcss-loader/src/index.js","mtime":499162500000},{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["TreeNode.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAkPA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA","file":"TreeNode.vue","sourceRoot":"src/components","sourcesContent":["<template>\n  <div class=\"tree-node\">\n    <div\n      class=\"node-row\"\n      @mouseenter=\"hovered = true\"\n      @mouseleave=\"hovered = false\"\n    >\n      <!-- Expand / collapse arrow -->\n      <button\n        v-if=\"isExpandable\"\n        class=\"toggle-btn\"\n        @click=\"expanded = !expanded\"\n        :aria-label=\"expanded ? 'Collapse' : 'Expand'\"\n      >\n        <span :class=\"['arrow', { expanded }]\">▶</span>\n      </button>\n      <span v-else class=\"toggle-placeholder\" />\n\n      <!-- Key label -->\n      <span v-if=\"!isRoot\" class=\"key-area\">\n        <span v-if=\"isArrayItem\" class=\"array-index\">[{{ nodeKey }}]</span>\n        <template v-else>\n          <input\n            v-if=\"editingKey\"\n            ref=\"keyInput\"\n            v-model=\"pendingKey\"\n            class=\"key-input\"\n            @blur=\"commitKeyRename\"\n            @keyup.enter=\"commitKeyRename\"\n            @keyup.escape=\"cancelKeyRename\"\n          />\n          <span\n            v-else\n            class=\"key-label\"\n            title=\"Double-click to rename\"\n            @dblclick=\"startKeyEdit\"\n          >{{ nodeKey }}</span>\n        </template>\n        <span v-if=\"!isExpandable\" class=\"colon\">:&thinsp;</span>\n      </span>\n\n      <!-- Primitive value -->\n      <value-editor\n        v-if=\"!isExpandable\"\n        :value=\"nodeValue\"\n        @change=\"setValue\"\n      />\n\n      <!-- Object / array summary badge -->\n      <span\n        v-else\n        :class=\"['type-badge', isArray ? 'badge-array' : 'badge-object']\"\n        @click=\"expanded = !expanded\"\n      >\n        {{ isArray ? `[ ${nodeValue.length} ]` : `{ ${keyCount} }` }}\n      </span>\n\n      <!-- Action buttons (shown on hover) -->\n      <span class=\"node-actions\" :class=\"{ visible: hovered }\">\n        <button\n          v-if=\"isExpandable\"\n          class=\"action-btn\"\n          title=\"Add child field\"\n          @click.stop=\"showAddChild = !showAddChild\"\n        >+</button>\n        <template v-if=\"isArrayItem\">\n          <button\n            v-if=\"nodeKey > 0\"\n            class=\"action-btn\"\n            title=\"Move up\"\n            @click.stop=\"moveUp\"\n          >↑</button>\n          <button\n            v-if=\"!isLastItem\"\n            class=\"action-btn\"\n            title=\"Move down\"\n            @click.stop=\"moveDown\"\n          >↓</button>\n        </template>\n        <button\n          v-if=\"!isRoot\"\n          class=\"action-btn delete-btn\"\n          title=\"Delete\"\n          @click.stop=\"deleteNode\"\n        >✕</button>\n      </span>\n    </div>\n\n    <!-- Add-child inline form -->\n    <div v-if=\"showAddChild\" class=\"add-child-form\">\n      <input\n        v-if=\"!isArray\"\n        v-model=\"newChildKey\"\n        placeholder=\"key name\"\n        class=\"input-sm\"\n        @keyup.enter=\"addChild\"\n        @keyup.escape=\"cancelAddChild\"\n      />\n      <select v-model=\"newChildType\" class=\"input-sm select-sm\">\n        <option value=\"string\">string</option>\n        <option value=\"number\">number</option>\n        <option value=\"boolean\">boolean</option>\n        <option value=\"null\">null</option>\n        <option value=\"object\">object {}</option>\n        <option value=\"array\">array []</option>\n      </select>\n      <button class=\"btn-add\" @click=\"addChild\">Add</button>\n      <button class=\"btn-cancel\" @click=\"cancelAddChild\">Cancel</button>\n    </div>\n\n    <!-- Children -->\n    <div v-if=\"expanded && isExpandable\" class=\"children\">\n      <template v-if=\"isArray\">\n        <tree-node\n          v-for=\"(item, index) in nodeValue\"\n          :key=\"index\"\n          :node-key=\"index\"\n          :node-value=\"item\"\n          :node-path=\"childPath(index)\"\n          :is-array-item=\"true\"\n          :is-last-item=\"index === nodeValue.length - 1\"\n        />\n      </template>\n      <template v-else>\n        <tree-node\n          v-for=\"key in Object.keys(nodeValue)\"\n          :key=\"key\"\n          :node-key=\"key\"\n          :node-value=\"nodeValue[key]\"\n          :node-path=\"childPath(key)\"\n        />\n      </template>\n    </div>\n  </div>\n</template>\n\n<script>\nimport ValueEditor from \"./ValueEditor.vue\";\n\nexport default {\n  name: \"TreeNode\",\n  components: { ValueEditor },\n  props: {\n    nodeKey:     { type: [String, Number], default: null },\n    nodeValue:   { default: null },\n    nodePath:    { type: Array, default: () => [] },\n    isRoot:      { type: Boolean, default: false },\n    isArrayItem: { type: Boolean, default: false },\n    isLastItem:  { type: Boolean, default: false },\n  },\n  data() {\n    return {\n      expanded:     this.isRoot,\n      hovered:      false,\n      editingKey:   false,\n      pendingKey:   \"\",\n      showAddChild: false,\n      newChildKey:  \"\",\n      newChildType: \"string\",\n    };\n  },\n  computed: {\n    isExpandable() {\n      return this.nodeValue !== null &&\n             this.nodeValue !== undefined &&\n             typeof this.nodeValue === \"object\";\n    },\n    isArray() {\n      return Array.isArray(this.nodeValue);\n    },\n    keyCount() {\n      return this.isExpandable && !this.isArray\n        ? Object.keys(this.nodeValue).length\n        : 0;\n    },\n  },\n  methods: {\n    childPath(key) {\n      return [...this.nodePath, key];\n    },\n    setValue(newValue) {\n      this.$store.commit(\"SET_VALUE\", { path: this.nodePath, value: newValue });\n    },\n    startKeyEdit() {\n      this.pendingKey = String(this.nodeKey);\n      this.editingKey = true;\n      this.$nextTick(() => {\n        if (this.$refs.keyInput) {\n          this.$refs.keyInput.focus();\n          this.$refs.keyInput.select();\n        }\n      });\n    },\n    commitKeyRename() {\n      const trimmed = this.pendingKey.trim();\n      if (trimmed && trimmed !== String(this.nodeKey)) {\n        this.$store.commit(\"RENAME_KEY\", { path: this.nodePath, newKey: trimmed });\n      }\n      this.editingKey = false;\n    },\n    cancelKeyRename() {\n      this.editingKey = false;\n    },\n    deleteNode() {\n      if (window.confirm(`Delete \"${this.nodeKey}\"?`)) {\n        this.$store.commit(\"DELETE_NODE\", { path: this.nodePath });\n      }\n    },\n    moveUp() {\n      this.$store.commit(\"MOVE_ITEM\", {\n        parentPath: this.nodePath.slice(0, -1),\n        fromIndex: this.nodeKey,\n        toIndex: this.nodeKey - 1,\n      });\n    },\n    moveDown() {\n      this.$store.commit(\"MOVE_ITEM\", {\n        parentPath: this.nodePath.slice(0, -1),\n        fromIndex: this.nodeKey,\n        toIndex: this.nodeKey + 1,\n      });\n    },\n    addChild() {\n      if (!this.isArray && !this.newChildKey.trim()) return;\n      this.$store.commit(\"ADD_CHILD\", {\n        path: this.nodePath,\n        key: this.newChildKey.trim(),\n        type: this.newChildType,\n      });\n      this.expanded = true;\n      this.cancelAddChild();\n    },\n    cancelAddChild() {\n      this.showAddChild = false;\n      this.newChildKey  = \"\";\n      this.newChildType = \"string\";\n    },\n  },\n};\n</script>\n\n<style scoped>\n.tree-node {\n  font-family: \"Fira Code\", \"Consolas\", \"Courier New\", monospace;\n  font-size: 12px;\n}\n\n.node-row {\n  display: flex;\n  align-items: center;\n  padding: 2px 6px 2px 0;\n  border-radius: 3px;\n  min-height: 24px;\n  gap: 2px;\n}\n.node-row:hover {\n  background: #f0f4ff;\n}\n\n.toggle-btn {\n  background: none;\n  border: none;\n  width: 18px;\n  height: 18px;\n  padding: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  color: #555;\n}\n.toggle-btn:hover { color: #000; }\n\n.toggle-placeholder {\n  width: 18px;\n  flex-shrink: 0;\n  display: inline-block;\n}\n\n.arrow {\n  display: inline-block;\n  font-size: 9px;\n  transition: transform 0.15s;\n  line-height: 1;\n}\n.arrow.expanded {\n  transform: rotate(90deg);\n}\n\n.key-area {\n  display: inline-flex;\n  align-items: center;\n  flex-shrink: 0;\n}\n\n.key-label {\n  color: #0550ae;\n  font-weight: 600;\n  cursor: default;\n  border-radius: 2px;\n  padding: 0 2px;\n}\n.key-label:hover {\n  background: #dbeafe;\n  cursor: text;\n}\n\n.array-index {\n  color: #6b7280;\n  font-size: 11px;\n  margin-right: 2px;\n}\n\n.key-input {\n  border: 1px solid #0066cc;\n  padding: 0 4px;\n  width: 120px;\n  font-family: inherit;\n  font-size: 12px;\n  font-weight: 600;\n  color: #0550ae;\n  background: #fff;\n}\n\n.colon {\n  color: #888;\n}\n\n.type-badge {\n  font-size: 10px;\n  padding: 1px 6px;\n  border-radius: 10px;\n  cursor: pointer;\n  user-select: none;\n  font-family: -apple-system, sans-serif;\n}\n.badge-object {\n  background: #e8f0fe;\n  color: #1a56db;\n}\n.badge-array {\n  background: #fef3c7;\n  color: #92400e;\n}\n\n/* Action buttons */\n.node-actions {\n  display: inline-flex;\n  align-items: center;\n  gap: 2px;\n  margin-left: 6px;\n  opacity: 0;\n  transition: opacity 0.1s;\n}\n.node-actions.visible {\n  opacity: 1;\n}\n\n.action-btn {\n  background: #e8eaed;\n  color: #333;\n  border: none;\n  border-radius: 3px;\n  width: 20px;\n  height: 20px;\n  font-size: 11px;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 0;\n  line-height: 1;\n}\n.action-btn:hover { background: #d0d0d0; }\n\n.delete-btn:hover {\n  background: #fee2e2;\n  color: #dc2626;\n}\n\n/* Add-child form */\n.add-child-form {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  padding: 4px 6px 4px 26px;\n  background: #f8faff;\n  border-left: 2px solid #bfdbfe;\n  margin: 2px 0;\n}\n\n.input-sm {\n  border: 1px solid #ccc;\n  padding: 3px 6px;\n  font-size: 12px;\n  background: #fff;\n}\n.select-sm { cursor: pointer; }\n\n.btn-add {\n  background: #0066cc;\n  color: #fff;\n  padding: 3px 10px;\n  font-size: 11px;\n}\n.btn-add:hover { background: #0052a3; }\n\n.btn-cancel {\n  background: transparent;\n  color: #666;\n  padding: 3px 8px;\n  font-size: 11px;\n}\n.btn-cancel:hover { color: #333; }\n\n/* Children indentation */\n.children {\n  padding-left: 18px;\n  border-left: 1px solid #e5e7eb;\n  margin-left: 9px;\n}\n</style>\n"]}]}
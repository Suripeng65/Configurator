{"remainingRequest":"/Users/siyu/personalProject/siyu-cartogram/cartogram-vue/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/siyu/personalProject/siyu-cartogram/cartogram-vue/src/components/Cartogram.vue?vue&type=script&lang=js&","dependencies":[{"path":"/Users/siyu/personalProject/siyu-cartogram/cartogram-vue/src/components/Cartogram.vue","mtime":1594060486887},{"path":"/Users/siyu/personalProject/siyu-cartogram/cartogram-vue/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/siyu/personalProject/siyu-cartogram/cartogram-vue/node_modules/babel-loader/lib/index.js","mtime":499162500000},{"path":"/Users/siyu/personalProject/siyu-cartogram/cartogram-vue/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/siyu/personalProject/siyu-cartogram/cartogram-vue/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["Cartogram.vue"],"names":[],"mappings":";AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;;AAEA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA;AACA","file":"Cartogram.vue","sourceRoot":"src/components","sourcesContent":["<script>\nimport * as d3 from \"d3\";\nimport * as turf from \"@turf/turf\";\nimport { Draw } from \"../utils/draw.js\";\nimport compute from \"../utils/compute.js\";\nimport myJson from \"../assets/italy.json\";\n\nexport default {\n  components: {\n    Draw\n  },\n  data: function() {\n    return {\n      config: {\n        width : 700,\n  height : 700,\n  padding : 70,\n  projection : d3.geoMercator(),\n  duration : 1000,\n  key:function(d){return d.properties.NOME_REG; },\n  grid : {\n    TRENTINOALTOADIGE:{x:2,y:0},\n    AOSTA:{x:0,y:1},\n    PIEMONTE:{x:0,y:1},\n    LIGURIA:{x:0,y:1},\n    LOMBARDIA:{x:1,y:1},\n    VENETO:{x:2,y:1},\n    FRIULI:{x:3,y:1},\n    TOSCANA:{x:1,y:2},\n    UMBRIA:{x:1,y:2},\n    EMILIAROMAGNA:{x:2,y:2},\n    MARCHE:{x:3,y:3},\n    LAZIO:{x:2,y:3},\n    ABRUZZO:{x:3,y:4},\n    CAMPANIA:{x:4,y:4},\n    MOLISE:{x:3,y:5},\n    PUGLIA:{x:5,y:5},\n    BASILICATA:{x:3,y:5},\n    CALABRIA:{x:2,y:6},\n    SICILIA:{x:0,y:7},\n    SARDEGNA:{x:0,y:4}\n  }\n      }\n    };\n  },\n  mounted() {\n    this.initMap();\n    this.drawGeoMap();\n  },\n  methods: {\n    initMap() {\n      let svg = d3\n        .select(\"body\")\n        .append(\"svg\")\n        .attr(\"width\", this.config.width)\n        .attr(\"height\", this.config.height);\n\n      let geojson = compute(myJson);\n      console.log(geojson);\n      Object.assign(this.$Draw.config, this.config);\n      this.$Draw.data = geojson;\n      this.$Draw.svg = svg.append(\"g\");\n    },\n    drawGeoMap() {\n      this.$Draw.draw();\n    },\n    changeMapView() {\n      this.$Draw.toggle();\n      this.$Draw.draw();\n      console.log(this.$Draw.mode);\n    }\n  }\n};\n</script>\n\n<style>\nbody {\n  font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n}\n\npath {\n  fill: transparent;\n  stroke: rgba(0, 0, 0, 1);\n}\n\n/*4,*/\n\n.class-4 circle {\n  fill: red;\n}\n</style>\n<template>\n  <div>\n    <button @click=\"changeMapView\">Toggle</button>\n  </div>\n</template>"]}]}
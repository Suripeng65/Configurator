,EAAA,KAAA;AAAA,OAAA;AACA,UAAA,OAAA,GAAA,6CAAA,KAAA,SAAA,qDAAA,iBAAA,IAAA,uEAAA,EAAA,EAAA,OAAA,CAAA,MAAA,CAAA;;AACA,UAAA,OAAA,IAAA,CAAA,EAAA;AACA,aAAA,MAAA,CAAA,MAAA,CAAA,aAAA,EAAA;AAAA,UAAA,IAAA,EAAA,CAAA,KAAA,EAAA,YAAA,EAAA,MAAA,EAAA,OAAA;AAAA,SAAA;AACA;;AACA,UAAA,KAAA,UAAA,KAAA,MAAA,yBAAA,KAAA,SAAA,6EAAA,iBAAA,WAAA,CAAA,yDAAA,qBAAA,MAAA,CAAA,EAAA;AACA,aAAA,MAAA,CAAA,MAAA,CAAA,WAAA,EAAA;AAAA,UAAA,IAAA,EAAA,CAAA,KAAA,EAAA,YAAA,EAAA,YAAA,CAAA;AAAA,UAAA,KAAA,EAAA,KAAA,SAAA,CAAA,WAAA,EAAA,CAAA;AAAA,SAAA;AACA;AACA,KAnCA;AAoCA,IAAA,WApCA,yBAoCA;AACA,WAAA,WAAA,GAAA,EAAA;AACA,WAAA,SAAA,GAAA,EAAA;AACA,WAAA,WAAA,GAAA,UAAA;AACA,WAAA,QAAA,GAAA,EAAA;AACA,WAAA,SAAA,GAAA,IAAA;AACA,KA1CA;AA2CA,IAAA,aA3CA,2BA2CA;AAAA;;AACA,UAAA,GAAA,GAAA,KAAA,SAAA,CAAA,IAAA,GAAA,OAAA,CAAA,MAAA,EAAA,GAAA,CAAA;AACA,UAAA,KAAA,GAAA,KAAA,WAAA,CAAA,IAAA,EAAA;;AACA,UAAA,CAAA,GAAA,IAAA,CAAA,KAAA,EAAA;AAAA,aAAA,QAAA,GAAA,6BAAA;AAAA;AAAA;;AACA,8BAAA,KAAA,SAAA,qDAAA,iBAAA,GAAA,CAAA,EAAA;AAAA,aAAA,QAAA,mBAAA,GAAA;AAAA;AAAA;;AAEA,UAAA,SAAA,GAAA;AACA,QAAA,KAAA,EAAA,KADA;AAEA,QAAA,SAAA,EAAA,YAFA;AAGA,QAAA,QAAA,EAAA,CAAA;AAAA,UAAA,OAAA,EAAA,EAAA;AAAA,UAAA,QAAA,EAAA,CAAA;AAAA,YAAA,IAAA,EAAA,QAAA;AAAA,YAAA,SAAA,EAAA,KAAA,WAAA;AAAA,YAAA,cAAA,EAAA;AAAA,WAAA,CAAA;AAAA,UAAA,SAAA,EAAA;AAAA,SAAA,CAHA;AAIA,QAAA,WAAA,EAAA,CAAA;AAAA,UAAA,IAAA,EAAA,GAAA;AAAA,UAAA,SAAA,EAAA,YAAA;AAAA,yBAAA,EAAA;AAAA,+BAAA;AAAA,SAAA,CAJA;AAKA,uBAAA;AAAA,uBAAA,EAAA;AAAA,UAAA,UAAA,EAAA;AAAA,SALA;AAMA,2BAAA;AANA,OAAA;AASA,WAAA,MAAA,CAAA,MAAA,CAAA,WAAA,EAAA;AAAA,QAAA,IAAA,EAAA,CAAA,KAAA,EAAA,YAAA,CAAA;AAAA,QAAA,GAAA,EAAA,GAAA;AAAA,QAAA,IAAA,EAAA;AAAA,OAAA;AACA,WAAA,MAAA,CAAA,MAAA,CAAA,WAAA,EAAA;AAAA,QAAA,IAAA,EAAA,CAAA,KAAA,EAAA,YAAA,EAAA,GAAA,CAAA;AAAA,QAAA,KAAA,EAAA;AAAA,OAAA;AACA,WAAA,MAAA,CAAA,MAAA,CAAA,WAAA,EAAA;AAAA,QAAA,IAAA,EAAA,CAAA,KAAA,EAAA,YAAA,EAAA,WAAA,CAAA;AAAA,QAAA,GAAA,EAAA,IAAA;AAAA,QAAA,IAAA,EAAA;AAAA,OAAA;AACA,WAAA,MAAA,CAAA,MAAA,CAAA,WAAA,EAAA;AACA,QAAA,IAAA,EAAA,CAAA,KAAA,EAAA,YAAA,EAAA,WAAA,EAAA,mDAAA,KAAA,SAAA,CAAA,WAAA,CAAA,0DAAA,sBAAA,MAAA,yEAAA,CAAA,IAAA,CAAA,CADA;AAEA,QAAA,KAAA,EAAA;AAFA,OAAA;AAIA,WAAA,MAAA,CAAA,MAAA,CAAA,WAAA,EAAA;AAAA,QAAA,IAAA,EAAA,CAAA,KAAA,EAAA,YAAA,EAAA,MAAA,CAAA;AAAA,QAAA,GAAA,EAAA,IAAA;AAAA,QAAA,IAAA,EAAA;AAAA,OAAA;AACA,WAAA,MAAA,CAAA,MAAA,CAAA,WAAA,EAAA;AACA,QAAA,IAAA,EAAA,CAAA,KAAA,EAAA,YAAA,EAAA,MAAA,EAAA,mDAAA,KAAA,SAAA,CAAA,MAAA,CAAA,0DAAA,sBAAA,MAAA,yEAAA,CAAA,IAAA,CAAA,CADA;AAEA,QAAA,KAAA,EAAA;AAFA,OAAA;AAIA,WAAA,SAAA,GAAA,KAAA;AACA;AAvEA;AA1BA,CAAA","sourcesContent":["<template>\n  <div class=\"panel\">\n    <div class=\"panel-header\">\n      <div>\n        <h2 class=\"panel-title\">Visualization Tabs</h2>\n        <p class=\"panel-subtitle\">Reorder, rename, or remove chart tabs. The ★ tab loads by default.</p>\n      </div>\n    </div>\n\n    <div v-if=\"!mainPanel\" class=\"empty-state\">No main panel configuration found.</div>\n\n    <div v-else class=\"tab-list\">\n      <div\n        v-for=\"(tab, index) in tabList\"\n        :key=\"tab.key\"\n        class=\"tab-card\"\n        :class=\"{ 'is-default': tab.key === defaultTab }\"\n      >\n        <!-- Default star -->\n        <button\n          class=\"star-btn\"\n          :class=\"{ active: tab.key === defaultTab }\"\n          :title=\"tab.key === defaultTab ? 'Default tab' : 'Set as default'\"\n          @click=\"setDefault(tab.key)\"\n        >★</button>\n\n        <!-- Title -->\n        <div class=\"tab-info\">\n          <input\n            :value=\"tab.title\"\n            class=\"tab-title-input\"\n            placeholder=\"Tab title\"\n            @change=\"setTitle(tab.key, $event.target.value)\"\n          />\n          <span class=\"tab-key\">{{ tab.key }}</span>\n        </div>\n\n        <!-- Chart type badge -->\n        <span class=\"chart-badge\">{{ chartTypeLabel(tab.key) }}</span>\n\n        <!-- Reorder + delete -->\n        <div class=\"tab-actions\">\n          <button :disabled=\"index === 0\" class=\"icon-btn\" @click=\"moveTab(index, index - 1)\" title=\"Move up\">↑</button>\n          <button :disabled=\"index === tabList.length - 1\" class=\"icon-btn\" @click=\"moveTab(index, index + 1)\" title=\"Move down\">↓</button>\n          <button class=\"icon-btn delete\" @click=\"removeTab(index, tab.key)\" title=\"Remove tab\">✕</button>\n        </div>\n      </div>\n\n      <!-- Add tab -->\n      <div v-if=\"addingTab\" class=\"add-tab-form\">\n        <input v-model=\"newTabTitle\" placeholder=\"Tab title (e.g. My Chart)\" class=\"input-field\" />\n        <input v-model=\"newTabKey\" placeholder=\"Tab key (e.g. my_chart, no spaces)\" class=\"input-field\" />\n        <select v-model=\"newTabChart\" class=\"input-field\">\n          <option value=\"BarChart\">Bar Chart</option>\n          <option value=\"PieChart\">Pie Chart</option>\n          <option value=\"LineChart\">Line Chart</option>\n          <option value=\"StackedBarChart\">Stacked Bar</option>\n          <option value=\"DonutChart\">Donut Chart</option>\n          <option value=\"ScatterplotChart\">Scatterplot</option>\n          <option value=\"TreemapChart\">Treemap</option>\n        </select>\n        <button class=\"btn-confirm\" @click=\"confirmAddTab\">Add Tab</button>\n        <button class=\"btn-cancel-sm\" @click=\"addingTab = false\">Cancel</button>\n        <p v-if=\"addError\" class=\"add-error\">{{ addError }}</p>\n      </div>\n\n      <button v-else class=\"add-tab-btn\" @click=\"startAddTab\">+ Add Tab</button>\n    </div>\n  </div>\n</template>\n\n<script>\nconst CHART_LABELS = {\n  BarChart: \"Bar Chart\", PieChart: \"Pie Chart\", LineChart: \"Line Chart\",\n  StackedBarChart: \"Stacked Bar\", StackedAreaChart: \"Stacked Area\",\n  DonutChart: \"Donut\", ScatterplotChart: \"Scatterplot\", TreemapChart: \"Treemap\",\n  DataTable: \"Data Table\",\n};\n\nexport default {\n  name: \"MainTabsPanel\",\n  data() {\n    return {\n      addingTab: false,\n      newTabTitle: \"\",\n      newTabKey: \"\",\n      newTabChart: \"BarChart\",\n      addError: \"\",\n    };\n  },\n  computed: {\n    mainPanel() {\n      return this.$store.state.template?.layout?.viz?.[\"main-panel\"] ?? null;\n    },\n    tabList() {\n      if (!this.mainPanel) return [];\n      return (this.mainPanel[\"tab-array\"] ?? []).map(key => ({\n        key,\n        title: this.mainPanel[key]?.title ?? key,\n      }));\n    },\n    defaultTab() {\n      return this.mainPanel?.defaultTab ?? null;\n    },\n  },\n  methods: {\n    chartTypeLabel(tabKey) {\n      const tab = this.mainPanel?.[tabKey];\n      if (!tab?.contents) return \"\";\n      const charts = [];\n      const walk = (arr) => {\n        if (!Array.isArray(arr)) return;\n        arr.forEach(c => {\n          if (c.component && CHART_LABELS[c.component]) charts.push(CHART_LABELS[c.component]);\n          walk(c.contents);\n        });\n      };\n      walk(tab.contents);\n      return [...new Set(charts)].slice(0, 2).join(\" + \");\n    },\n    setTitle(tabKey, title) {\n      this.$store.commit(\"SET_VALUE\", { path: [\"viz\", \"main-panel\", tabKey, \"title\"], value: title });\n    },\n    setDefault(tabKey) {\n      this.$store.commit(\"SET_VALUE\", { path: [\"viz\", \"main-panel\", \"defaultTab\"], value: tabKey });\n    },\n    moveTab(fromIndex, toIndex) {\n      this.$store.commit(\"MOVE_ITEM\", { parentPath: [\"viz\", \"main-panel\", \"tab-array\"], fromIndex, toIndex });\n      this.$store.commit(\"MOVE_ITEM\", { parentPath: [\"viz\", \"main-panel\", \"tabs\"],      fromIndex, toIndex });\n    },\n    removeTab(index, tabKey) {\n      if (!confirm(`Remove tab \"${tabKey}\"?`)) return;\n      this.$store.commit(\"DELETE_NODE\", { path: [\"viz\", \"main-panel\", \"tab-array\", index] });\n      const tabsIdx = (this.mainPanel?.tabs ?? []).indexOf(tabKey);\n      if (tabsIdx >= 0) {\n        this.$store.commit(\"DELETE_NODE\", { path: [\"viz\", \"main-panel\", \"tabs\", tabsIdx] });\n      }\n      if (this.defaultTab === tabKey && this.mainPanel?.[\"tab-array\"]?.length) {\n        this.$store.commit(\"SET_VALUE\", { path: [\"viz\", \"main-panel\", \"defaultTab\"], value: this.mainPanel[\"tab-array\"][0] });\n      }\n    },\n    startAddTab() {\n      this.newTabTitle = \"\";\n      this.newTabKey = \"\";\n      this.newTabChart = \"BarChart\";\n      this.addError = \"\";\n      this.addingTab = true;\n    },\n    confirmAddTab() {\n      const key = this.newTabKey.trim().replace(/\\s+/g, \"_\");\n      const title = this.newTabTitle.trim();\n      if (!key || !title) { this.addError = \"Title and key are required.\"; return; }\n      if (this.mainPanel?.[key]) { this.addError = `Key \"${key}\" already exists.`; return; }\n\n      const tabConfig = {\n        title,\n        component: \"TabWrapper\",\n        contents: [{ layouts: [], contents: [{ cell: \"cell-1\", component: this.newTabChart, datasourceName: \"/\" }], component: \"GridContainer\" }],\n        datasources: [{ name: \"/\", component: \"Datasource\", \"dql-metrics\": [], \"flat-table-target\": \"\" }],\n        \"right-panel\": { \"tab-array\": [], defaultTab: null },\n        \"generate-report\": [],\n      };\n\n      this.$store.commit(\"ADD_CHILD\", { path: [\"viz\", \"main-panel\"], key, type: \"object\" });\n      this.$store.commit(\"SET_VALUE\", { path: [\"viz\", \"main-panel\", key], value: tabConfig });\n      this.$store.commit(\"ADD_CHILD\", { path: [\"viz\", \"main-panel\", \"tab-array\"], key: null, type: \"string\" });\n      this.$store.commit(\"SET_VALUE\", {\n        path: [\"viz\", \"main-panel\", \"tab-array\", (this.mainPanel[\"tab-array\"]?.length ?? 1) - 1],\n        value: key,\n      });\n      this.$store.commit(\"ADD_CHILD\", { path: [\"viz\", \"main-panel\", \"tabs\"], key: null, type: \"string\" });\n      this.$store.commit(\"SET_VALUE\", {\n        path: [\"viz\", \"main-panel\", \"tabs\", (this.mainPanel[\"tabs\"]?.length ?? 1) - 1],\n        value: key,\n      });\n      this.addingTab = false;\n    },\n  },\n};\n</script>\n\n<style scoped>\n.panel { padding: 28px 32px; max-width: 860px; }\n\n.panel-header { margin-bottom: 24px; }\n.panel-title  { font-size: 18px; font-weight: 700; color: #111; }\n.panel-subtitle { font-size: 13px; color: #6b7280; margin-top: 4px; }\n\n.tab-list { display: flex; flex-direction: column; gap: 8px; }\n\n.tab-card {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  background: #fff;\n  border: 1px solid #e5e7eb;\n  border-radius: 8px;\n  padding: 12px 14px;\n  transition: border-color 0.15s, box-shadow 0.15s;\n}\n.tab-card:hover { border-color: #c7d2fe; box-shadow: 0 1px 4px rgba(99,102,241,0.08); }\n.tab-card.is-default { border-color: #fbbf24; background: #fffbeb; }\n\n.star-btn {\n  font-size: 18px;\n  color: #d1d5db;\n  background: none;\n  padding: 0 2px;\n  line-height: 1;\n}\n.star-btn.active { color: #f59e0b; }\n.star-btn:hover:not(.active) { color: #fbbf24; }\n\n.tab-info { flex: 1; min-width: 0; }\n.tab-title-input {\n  border: 1px solid transparent;\n  background: transparent;\n  font-size: 14px;\n  font-weight: 600;\n  color: #111;\n  width: 100%;\n  padding: 2px 4px;\n  border-radius: 4px;\n}\n.tab-title-input:focus, .tab-title-input:hover { border-color: #d1d5db; background: #fff; }\n\n.tab-key {\n  display: block;\n  font-size: 11px;\n  color: #9ca3af;\n  font-family: monospace;\n  margin-top: 2px;\n  padding: 0 4px;\n}\n\n.chart-badge {\n  font-size: 11px;\n  background: #f3f4f6;\n  color: #374151;\n  padding: 3px 8px;\n  border-radius: 10px;\n  white-space: nowrap;\n  flex-shrink: 0;\n}\n\n.tab-actions { display: flex; gap: 4px; flex-shrink: 0; }\n.icon-btn {\n  width: 26px; height: 26px;\n  background: #f3f4f6;\n  color: #374151;\n  border-radius: 4px;\n  font-size: 13px;\n  display: flex; align-items: center; justify-content: center;\n}\n.icon-btn:hover:not(:disabled) { background: #e5e7eb; }\n.icon-btn:disabled { opacity: 0.3; cursor: default; }\n.icon-btn.delete:hover:not(:disabled) { background: #fee2e2; color: #dc2626; }\n\n/* Add tab */\n.add-tab-btn {\n  align-self: flex-start;\n  background: none;\n  border: 2px dashed #d1d5db;\n  color: #6b7280;\n  padding: 10px 20px;\n  border-radius: 8px;\n  font-size: 13px;\n  margin-top: 4px;\n  width: 100%;\n}\n.add-tab-btn:hover { border-color: #6366f1; color: #4f46e5; background: #f5f3ff; }\n\n.add-tab-form {\n  background: #f9fafb;\n  border: 1px solid #e5e7eb;\n  border-radius: 8px;\n  padding: 16px;\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n  align-items: center;\n}\n.input-field {\n  border: 1px solid #d1d5db;\n  padding: 6px 10px;\n  border-radius: 6px;\n  font-size: 13px;\n  background: #fff;\n  min-width: 160px;\n}\n.btn-confirm {\n  background: #4f46e5;\n  color: #fff;\n  padding: 6px 14px;\n  border-radius: 6px;\n  font-size: 13px;\n}\n.btn-confirm:hover { background: #4338ca; }\n.btn-cancel-sm { background: none; color: #6b7280; padding: 6px 10px; font-size: 13px; }\n.add-error { width: 100%; color: #dc2626; font-size: 12px; }\n\n.empty-state { color: #9ca3af; padding: 40px; text-align: center; }\n</style>\n"],"sourceRoot":"src/components/user"}]}
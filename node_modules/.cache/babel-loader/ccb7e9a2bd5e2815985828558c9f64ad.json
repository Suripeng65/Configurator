AAA;AACA,uCAAA,GAAA,gBAAA,KAAA;AACA,OARA,CAAA;AAUA;AAlBA;AALA,CAAA","sourcesContent":["<template>\n  <div class=\"json-preview\">\n    <pre v-html=\"highlighted\" />\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"JsonPreview\",\n  props: {\n    value: { default: null },\n  },\n  computed: {\n    highlighted() {\n      if (this.value == null) return \"\";\n      const json = JSON.stringify(this.value, null, 2);\n      const escaped = json\n        .replace(/&/g, \"&amp;\")\n        .replace(/</g, \"&lt;\")\n        .replace(/>/g, \"&gt;\");\n      return escaped.replace(\n        /(\"(\\\\u[a-zA-Z0-9]{4}|\\\\[^u]|[^\\\\\"])*\"(\\s*:)?|\\b(true|false|null)\\b|-?\\d+(?:\\.\\d*)?(?:[eE][+\\-]?\\d+)?)/g,\n        (match) => {\n          let cls = \"jn\";\n          if (/^\"/.test(match)) cls = /:$/.test(match) ? \"jk\" : \"js\";\n          else if (/true|false/.test(match)) cls = \"jb\";\n          else if (/null/.test(match)) cls = \"jnull\";\n          return `<span class=\"${cls}\">${match}</span>`;\n        }\n      );\n    },\n  },\n};\n</script>\n\n<style scoped>\n.json-preview {\n  background: #1e1e1e;\n  height: 100%;\n  overflow: auto;\n  padding: 16px;\n}\n\npre {\n  margin: 0;\n  font-family: \"Fira Code\", \"Consolas\", monospace;\n  font-size: 11.5px;\n  line-height: 1.6;\n  color: #d4d4d4;\n  white-space: pre;\n}\n</style>\n\n<!-- v-html content can't use scoped, use unscoped selectors via >>> -->\n<style>\n.json-preview pre .jk    { color: #9cdcfe; }\n.json-preview pre .js    { color: #ce9178; }\n.json-preview pre .jn    { color: #b5cea8; }\n.json-preview pre .jb    { color: #569cd6; }\n.json-preview pre .jnull { color: #569cd6; }\n</style>\n"],"sourceRoot":"src/components"}]}
{"remainingRequest":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/babel-loader/lib/index.js!/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/cache-loader/dist/cjs.js??ref--0-0!/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/vue-loader/lib/index.js??vue-loader-options!/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/src/components/ValueEditor.vue?vue&type=script&lang=js&","dependencies":[{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/src/components/ValueEditor.vue","mtime":1782688705717},{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/babel-loader/lib/index.js","mtime":499162500000},{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/cache-loader/dist/cjs.js","mtime":499162500000},{"path":"/Users/siyu/Documents/Stella/(Github)/Coding Project/Configurator/node_modules/vue-loader/lib/index.js","mtime":499162500000}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"sources":["ValueEditor.vue"],"names":[],"mappings":";;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;AAuCA,eAAA;AACA,EAAA,IAAA,EAAA,aADA;AAEA,EAAA,KAAA,EAAA;AACA,IAAA,KAAA,EAAA;AAAA,MAAA,OAAA,EAAA;AAAA;AADA,GAFA;AAKA,EAAA,IALA,kBAKA;AACA,WAAA;AACA,MAAA,OAAA,EAAA,KADA;AAEA,MAAA,KAAA,EAAA;AAFA,KAAA;AAIA,GAVA;AAWA,EAAA,QAAA,EAAA;AACA,IAAA,SADA,uBACA;AACA,UAAA,KAAA,KAAA,KAAA,IAAA,IAAA,KAAA,KAAA,KAAA,SAAA,EAAA,OAAA,MAAA;AACA,UAAA,KAAA,CAAA,OAAA,CAAA,KAAA,KAAA,CAAA,EAAA,OAAA,OAAA;AACA,qBAAA,KAAA,KAAA;AACA,KALA;AAMA,IAAA,SANA,uBAMA;AACA,UAAA,CAAA,GAAA,MAAA,CAAA,KAAA,KAAA,CAAA;AACA,aAAA,CAAA,CAAA,MAAA,GAAA,EAAA,GAAA,CAAA,CAAA,KAAA,CAAA,CAAA,EAAA,EAAA,IAAA,GAAA,GAAA,CAAA;AACA;AATA,GAXA;AAsBA,EAAA,OAAA,EAAA;AACA,IAAA,SADA,uBACA;AAAA;;AACA,WAAA,KAAA,GAAA,MAAA,CAAA,KAAA,KAAA,CAAA;AACA,WAAA,OAAA,GAAA,IAAA;AACA,WAAA,SAAA,CAAA,YAAA;AACA,YAAA,KAAA,CAAA,KAAA,CAAA,KAAA,EAAA;AACA,UAAA,KAAA,CAAA,KAAA,CAAA,KAAA,CAAA,KAAA;;AACA,UAAA,KAAA,CAAA,KAAA,CAAA,KAAA,CAAA,MAAA;AACA;AACA,OALA;AAMA,KAVA;AAWA,IAAA,MAXA,oBAWA;AACA,UAAA,MAAA,GAAA,KAAA,KAAA;;AACA,UAAA,KAAA,SAAA,KAAA,QAAA,EAAA;AACA,YAAA,CAAA,GAAA,UAAA,CAAA,KAAA,KAAA,CAAA;AACA,QAAA,MAAA,GAAA,KAAA,CAAA,CAAA,CAAA,GAAA,KAAA,KAAA,GAAA,CAAA;AACA;;AACA,WAAA,KAAA,CAAA,QAAA,EAAA,MAAA;AACA,WAAA,OAAA,GAAA,KAAA;AACA,KAnBA;AAoBA,IAAA,MApBA,oBAoBA;AACA,WAAA,OAAA,GAAA,KAAA;AACA;AAtBA;AAtBA,CAAA","sourcesContent":["<template>\n  <span class=\"value-editor\">\n    <!-- Boolean: click-to-toggle button -->\n    <button\n      v-if=\"valueType === 'boolean'\"\n      :class=\"['bool-btn', value ? 'bool-true' : 'bool-false']\"\n      @click=\"$emit('change', !value)\"\n    >{{ value ? 'true' : 'false' }}</button>\n\n    <!-- Null -->\n    <span v-else-if=\"valueType === 'null'\" class=\"null-val\">null</span>\n\n    <!-- Editing: text/number input -->\n    <input\n      v-else-if=\"editing\"\n      ref=\"input\"\n      v-model=\"draft\"\n      :type=\"valueType === 'number' ? 'number' : 'text'\"\n      class=\"value-input\"\n      :style=\"{ width: Math.max(60, draft.length * 7.5 + 16) + 'px' }\"\n      @blur=\"commit\"\n      @keyup.enter=\"commit\"\n      @keyup.escape=\"cancel\"\n    />\n\n    <!-- Display -->\n    <span\n      v-else\n      :class=\"['value-display', `val-${valueType}`]\"\n      :title=\"String(value)\"\n      @click=\"startEdit\"\n    >\n      <template v-if=\"valueType === 'string'\">\"{{ truncated }}\"</template>\n      <template v-else>{{ value }}</template>\n    </span>\n  </span>\n</template>\n\n<script>\nexport default {\n  name: \"ValueEditor\",\n  props: {\n    value: { default: null },\n  },\n  data() {\n    return {\n      editing: false,\n      draft: \"\",\n    };\n  },\n  computed: {\n    valueType() {\n      if (this.value === null || this.value === undefined) return \"null\";\n      if (Array.isArray(this.value)) return \"array\";\n      return typeof this.value;\n    },\n    truncated() {\n      const s = String(this.value);\n      return s.length > 80 ? s.slice(0, 80) + \"…\" : s;\n    },\n  },\n  methods: {\n    startEdit() {\n      this.draft = String(this.value);\n      this.editing = true;\n      this.$nextTick(() => {\n        if (this.$refs.input) {\n          this.$refs.input.focus();\n          this.$refs.input.select();\n        }\n      });\n    },\n    commit() {\n      let newVal = this.draft;\n      if (this.valueType === \"number\") {\n        const n = parseFloat(this.draft);\n        newVal = isNaN(n) ? this.draft : n;\n      }\n      this.$emit(\"change\", newVal);\n      this.editing = false;\n    },\n    cancel() {\n      this.editing = false;\n    },\n  },\n};\n</script>\n\n<style scoped>\n.value-editor {\n  display: inline-flex;\n  align-items: center;\n}\n\n.value-display {\n  cursor: text;\n  border-radius: 2px;\n  padding: 1px 3px;\n}\n.value-display:hover {\n  background: #e8f0fe;\n  text-decoration: underline dotted;\n}\n\n.val-string  { color: #a31515; }\n.val-number  { color: #098658; }\n\n.value-input {\n  border: 1px solid #0066cc;\n  background: #fff;\n  padding: 1px 4px;\n  min-width: 60px;\n  max-width: 480px;\n  font-family: \"Fira Code\", \"Consolas\", monospace;\n  font-size: 12px;\n}\n\n.bool-btn {\n  font-size: 11px;\n  padding: 1px 6px;\n  border-radius: 10px;\n  font-weight: 600;\n}\n.bool-true  { background: #d1fae5; color: #065f46; }\n.bool-false { background: #fee2e2; color: #7f1d1d; }\n.bool-btn:hover { opacity: 0.8; }\n\n.null-val {\n  color: #6b7280;\n  font-style: italic;\n  font-size: 11px;\n}\n</style>\n"],"sourceRoot":"src/components"}]}
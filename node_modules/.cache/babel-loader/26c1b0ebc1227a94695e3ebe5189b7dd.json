EAAA,EAAA;AACA,KAZA;AAaA,IAAA,iBAbA,+BAaA;AAAA;;AACA,aAAA,KAAA,QAAA,CAAA,GAAA,CAAA,UAAA,GAAA;AAAA;;AAAA,eAAA;AACA,UAAA,GAAA,EAAA,GADA;AAEA,UAAA,KAAA,kDAAA,KAAA,CAAA,SAAA,CAAA,GAAA,CAAA,wDAAA,oBAAA,KAAA,yEAAA;AAFA,SAAA;AAAA,OAAA,CAAA;AAIA,KAlBA;AAmBA,IAAA,eAnBA,6BAmBA;AAAA;;AACA,8CAAA,KAAA,iBAAA,yEAAA,KAAA,QAAA,CAAA,CAAA,CAAA,uCAAA,IAAA;AACA,KArBA;AAsBA,IAAA,qBAtBA,mCAsBA;AAAA;;AACA,UAAA,CAAA,KAAA,eAAA,EAAA,OAAA,IAAA;AACA,UAAA,KAAA,sDAAA,KAAA,SAAA,CAAA,KAAA,eAAA,CAAA,2DAAA,uBAAA,WAAA,yEAAA,EAAA;AACA,UAAA,GAAA,GAAA,KAAA,CAAA,SAAA,CAAA,UAAA,CAAA;AAAA,eAAA,CAAA,CAAA,IAAA,KAAA,GAAA;AAAA,OAAA,CAAA;AACA,UAAA,GAAA,GAAA,CAAA,EAAA,OAAA,IAAA;AACA,aAAA,CAAA,KAAA,EAAA,YAAA,EAAA,KAAA,eAAA,EAAA,aAAA,EAAA,GAAA,EAAA,aAAA,CAAA;AACA,KA5BA;AA6BA,IAAA,cA7BA,4BA6BA;AAAA;;AACA,UAAA,CAAA,KAAA,qBAAA,EAAA,OAAA,EAAA;AACA,UAAA,GAAA,GAAA,KAAA,SAAA,CAAA,KAAA,eAAA,CAAA;AACA,UAAA,EAAA,GAAA,qBAAA,GAAA,aAAA,GAAA,uBAAA,GAAA,CAAA,WAAA,+DAAA,EAAA,EAAA,IAAA,CAAA,UAAA,CAAA;AAAA,eAAA,CAAA,CAAA,IAAA,KAAA,GAAA;AAAA,OAAA,CAAA;AACA,+BAAA,EAAA,aAAA,EAAA,uBAAA,EAAA,CAAA,aAAA,CAAA,2DAAA,EAAA;AACA,KAlCA;AAmCA;AACA,IAAA,WApCA,yBAoCA;AAAA;;AACA,mEAAA,KAAA,SAAA,qDAAA,iBAAA,UAAA,yEAAA,KAAA,QAAA,CAAA,CAAA,CAAA,yCAAA,IAAA;AACA,KAtCA;AAuCA,IAAA,OAvCA,qBAuCA;AAAA;;AACA,UAAA,CAAA,KAAA,WAAA,EAAA,OAAA,IAAA;AACA,sBAAA,qDAAA,KAAA,SAAA,CAAA,KAAA,WAAA,CAAA,2DAAA,uBAAA,WAAA,2EAAA,EAAA,EAAA,IAAA,CAAA,UAAA,CAAA;AAAA,eAAA,CAAA,CAAA,IAAA,KAAA,GAAA;AAAA,OAAA,CAAA,yCAAA,IAAA;AACA,KA1CA;AA2CA,IAAA,eA3CA,6BA2CA;AAAA;;AACA,qDAAA,KAAA,OAAA,kDAAA,cAAA,KAAA,qEAAA,EAAA;AACA,KA7CA;AA8CA,IAAA,WA9CA,yBA8CA;AAAA;;AACA,UAAA,CAAA,KAAA,WAAA,EAAA,OAAA,IAAA;AACA,UAAA,GAAA,GAAA,qDAAA,KAAA,SAAA,CAAA,KAAA,WAAA,CAAA,2DAAA,uBAAA,WAAA,2EAAA,EAAA,EAAA,SAAA,CAAA,UAAA,CAAA;AAAA,eAAA,CAAA,CAAA,IAAA,KAAA,GAAA;AAAA,OAAA,CAAA;AACA,aAAA,GAAA,IAAA,CAAA,GAAA,CAAA,KAAA,EAAA,YAAA,EAAA,KAAA,WAAA,EAAA,aAAA,EAAA,GAAA,CAAA,GAAA,IAAA;AACA;AAlDA,GARA;AA4DA,EAAA,OA5DA,qBA4DA;AAAA;;AACA,SAAA,iBAAA,sBAAA,KAAA,QAAA,CAAA,CAAA,CAAA,6DAAA,IAAA;AACA,GA9DA;AA+DA,EAAA,OAAA,EAAA;AACA,IAAA,gBADA,4BACA,KADA,EACA,KADA,EACA,KADA,EACA;AACA,WAAA,MAAA,CAAA,MAAA,CAAA,WAAA,EAAA;AACA,QAAA,IAAA,EAAA,CAAA,KAAA,EAAA,YAAA,EAAA,aAAA,EAAA,KAAA,EAAA,KAAA,CADA;AAEA,QAAA,KAAA,EAAA;AAFA,OAAA;AAIA,KANA;AAOA,IAAA,YAPA,wBAOA,GAPA,EAOA;AACA,WAAA,MAAA,CAAA,MAAA,CAAA,aAAA,EAAA;AAAA,QAAA,IAAA,+BAAA,KAAA,qBAAA,IAAA,GAAA;AAAA,OAAA;AACA,KATA;AAUA,IAAA,SAVA,uBAUA;AACA,UAAA,CAAA,GAAA,KAAA,SAAA,CAAA,IAAA,EAAA;AACA,UAAA,CAAA,CAAA,EAAA;AACA,WAAA,MAAA,CAAA,MAAA,CAAA,WAAA,EAAA;AAAA,QAAA,IAAA,EAAA,KAAA,qBAAA;AAAA,QAAA,GAAA,EAAA,IAAA;AAAA,QAAA,IAAA,EAAA;AAAA,OAAA;AACA,WAAA,MAAA,CAAA,MAAA,CAAA,WAAA,EAAA;AACA,QAAA,IAAA,+BAAA,KAAA,qBAAA,IAAA,KAAA,cAAA,CAAA,MAAA,EADA;AAEA,QAAA,KAAA,EAAA;AAFA,OAAA;AAIA,WAAA,SAAA,GAAA,EAAA;AACA,KAnBA;AAoBA,IAAA,OApBA,mBAoBA,OApBA,EAoBA,KApBA,EAoBA,KApBA,EAoBA;AACA,UAAA,CAAA,KAAA,WAAA,EAAA;AACA,WAAA,MAAA,CAAA,MAAA,CAAA,WAAA,EAAA;AACA,QAAA,IAAA,+BAAA,KAAA,WAAA,IAAA,OAAA,EAAA,OAAA,EAAA,KAAA,EADA;AAEA,QAAA,KAAA,EAAA;AAFA,OAAA;AAIA;AA1BA;AA/DA,CAAA","sourcesContent":["<template>\n  <div class=\"panel\">\n    <div class=\"panel-header\">\n      <h2 class=\"panel-title\">Datasources</h2>\n      <p class=\"panel-subtitle\">Configure lookup tables, metrics available to charts, and validation rules.</p>\n    </div>\n\n    <!-- Shared datasources (/dx, /hcpcs, /sg) -->\n    <section class=\"ds-section\">\n      <h3 class=\"section-title\">Lookup Datasources</h3>\n      <p class=\"section-desc\">These feed the filter dropdowns (Diagnosis codes, HCPCS codes, etc.)</p>\n\n      <div v-if=\"!sharedDs.length\" class=\"empty-state\">No shared datasources configured.</div>\n\n      <div class=\"ds-cards\">\n        <div v-for=\"(ds, idx) in sharedDs\" :key=\"ds.name\" class=\"ds-card\">\n          <div class=\"ds-card-header\">\n            <code class=\"ds-name\">{{ ds.name }}</code>\n            <label class=\"toggle-label\">\n              <input\n                type=\"checkbox\"\n                :checked=\"ds['auto-load']\"\n                @change=\"setSharedDsField(idx, 'auto-load', $event.target.checked)\"\n              />\n              Auto-load\n            </label>\n          </div>\n          <div class=\"ds-card-body\">\n            <div class=\"field-row\">\n              <span class=\"field-key\">Flat Table</span>\n              <input\n                :value=\"ds['flat-table-target']\"\n                class=\"field-input\"\n                @change=\"setSharedDsField(idx, 'flat-table-target', $event.target.value)\"\n              />\n            </div>\n            <div class=\"field-row\">\n              <span class=\"field-key\">Max items</span>\n              <input\n                :value=\"ds['select-multiple-items']\"\n                type=\"number\"\n                class=\"field-input field-input--sm\"\n                @change=\"setSharedDsField(idx, 'select-multiple-items', Number($event.target.value))\"\n              />\n            </div>\n            <div v-if=\"ds['on-select-item']\" class=\"field-row\">\n              <span class=\"field-key\">Maps to dim</span>\n              <code class=\"field-code\">{{ Object.values(ds['on-select-item'].monitor || {})[0] }}</code>\n            </div>\n          </div>\n        </div>\n      </div>\n    </section>\n\n    <!-- Per-tab metrics -->\n    <section class=\"ds-section\">\n      <h3 class=\"section-title\">DQL Metrics</h3>\n      <p class=\"section-desc\">\n        Metrics available in chart tabs. Select a tab to edit its metric list.\n        Each metric corresponds to a computed column available in visualizations.\n      </p>\n\n      <div class=\"tab-selector\">\n        <label class=\"field-key\">Tab</label>\n        <select v-model=\"selectedMetricTab\" class=\"field-input field-input--select\">\n          <option v-for=\"t in metricsTabOptions\" :key=\"t.key\" :value=\"t.key\">{{ t.title }}</option>\n        </select>\n      </div>\n\n      <div v-if=\"selectedMetricsDsPath\" class=\"metrics-editor\">\n        <div class=\"metrics-chips\">\n          <span\n            v-for=\"(m, idx) in currentMetrics\"\n            :key=\"m + idx\"\n            class=\"metric-chip\"\n          >\n            {{ m }}\n            <button class=\"remove-chip\" @click=\"removeMetric(idx)\">×</button>\n          </span>\n          <input\n            v-model=\"newMetric\"\n            class=\"metric-input\"\n            placeholder=\"add metric…\"\n            @keyup.enter=\"addMetric\"\n          />\n        </div>\n        <button class=\"add-metric-btn\" @click=\"addMetric\">+ Add</button>\n      </div>\n    </section>\n\n    <!-- Validation rules -->\n    <section class=\"ds-section\">\n      <h3 class=\"section-title\">Validation Rules</h3>\n      <p class=\"section-desc\">Rules that must pass before the chart loads data. Shown to users as messages.</p>\n\n      <div v-if=\"!validationRules.length\" class=\"empty-state\">No rules found in the default tab datasource.</div>\n\n      <table v-else class=\"rules-table\">\n        <thead>\n          <tr>\n            <th>Rule Name</th>\n            <th>Expression</th>\n            <th>User Message</th>\n            <th>Visible</th>\n          </tr>\n        </thead>\n        <tbody>\n          <tr v-for=\"(rule, idx) in validationRules\" :key=\"rule.ruleName\">\n            <td><code class=\"field-code\">{{ rule.ruleName }}</code></td>\n            <td><code class=\"rule-expr\">{{ rule.rule }}</code></td>\n            <td>\n              <input\n                :value=\"rule.message\"\n                class=\"field-input\"\n                @change=\"setRule(idx, 'message', $event.target.value)\"\n              />\n            </td>\n            <td class=\"center\">\n              <input\n                type=\"checkbox\"\n                :checked=\"rule.visible\"\n                @change=\"setRule(idx, 'visible', $event.target.checked)\"\n              />\n            </td>\n          </tr>\n        </tbody>\n      </table>\n    </section>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: \"DatasourcesPanel\",\n  data() {\n    return {\n      selectedMetricTab: null,\n      newMetric: \"\",\n    };\n  },\n  computed: {\n    layout() {\n      return this.$store.state.template?.layout ?? {};\n    },\n    mainPanel() {\n      return this.layout?.viz?.[\"main-panel\"] ?? {};\n    },\n    sharedDs() {\n      return this.mainPanel?.datasources ?? [];\n    },\n    tabArray() {\n      return this.mainPanel?.[\"tab-array\"] ?? [];\n    },\n    metricsTabOptions() {\n      return this.tabArray.map(key => ({\n        key,\n        title: this.mainPanel[key]?.title ?? key,\n      }));\n    },\n    activeMetricTab() {\n      return this.selectedMetricTab ?? this.tabArray[0] ?? null;\n    },\n    selectedMetricsDsPath() {\n      if (!this.activeMetricTab) return null;\n      const tabDs = this.mainPanel[this.activeMetricTab]?.datasources ?? [];\n      const idx = tabDs.findIndex(d => d.name === \"/\");\n      if (idx < 0) return null;\n      return [\"viz\", \"main-panel\", this.activeMetricTab, \"datasources\", idx, \"dql-metrics\"];\n    },\n    currentMetrics() {\n      if (!this.selectedMetricsDsPath) return [];\n      const tab = this.mainPanel[this.activeMetricTab];\n      const ds = (tab?.datasources ?? []).find(d => d.name === \"/\");\n      return ds?.[\"dql-metrics\"] ?? [];\n    },\n    // Rules from the default (first) tab's root datasource\n    rulesTabKey() {\n      return this.mainPanel?.defaultTab ?? this.tabArray[0] ?? null;\n    },\n    rulesDs() {\n      if (!this.rulesTabKey) return null;\n      return (this.mainPanel[this.rulesTabKey]?.datasources ?? []).find(d => d.name === \"/\") ?? null;\n    },\n    validationRules() {\n      return this.rulesDs?.rules ?? [];\n    },\n    rulesDsPath() {\n      if (!this.rulesTabKey) return null;\n      const idx = (this.mainPanel[this.rulesTabKey]?.datasources ?? []).findIndex(d => d.name === \"/\");\n      return idx >= 0 ? [\"viz\", \"main-panel\", this.rulesTabKey, \"datasources\", idx] : null;\n    },\n  },\n  mounted() {\n    this.selectedMetricTab = this.tabArray[0] ?? null;\n  },\n  methods: {\n    setSharedDsField(dsIdx, field, value) {\n      this.$store.commit(\"SET_VALUE\", {\n        path: [\"viz\", \"main-panel\", \"datasources\", dsIdx, field],\n        value,\n      });\n    },\n    removeMetric(idx) {\n      this.$store.commit(\"DELETE_NODE\", { path: [...this.selectedMetricsDsPath, idx] });\n    },\n    addMetric() {\n      const m = this.newMetric.trim();\n      if (!m) return;\n      this.$store.commit(\"ADD_CHILD\", { path: this.selectedMetricsDsPath, key: null, type: \"string\" });\n      this.$store.commit(\"SET_VALUE\", {\n        path: [...this.selectedMetricsDsPath, this.currentMetrics.length],\n        value: m,\n      });\n      this.newMetric = \"\";\n    },\n    setRule(ruleIdx, field, value) {\n      if (!this.rulesDsPath) return;\n      this.$store.commit(\"SET_VALUE\", {\n        path: [...this.rulesDsPath, \"rules\", ruleIdx, field],\n        value,\n      });\n    },\n  },\n};\n</script>\n\n<style scoped>\n.panel { padding: 28px 32px; max-width: 900px; }\n.panel-header { margin-bottom: 28px; }\n.panel-title  { font-size: 18px; font-weight: 700; color: #111; }\n.panel-subtitle { font-size: 13px; color: #6b7280; margin-top: 4px; }\n\n.ds-section { margin-bottom: 36px; }\n.section-title { font-size: 14px; font-weight: 700; color: #374151; margin-bottom: 4px; }\n.section-desc  { font-size: 12px; color: #9ca3af; margin-bottom: 14px; line-height: 1.5; }\n\n/* Lookup datasource cards */\n.ds-cards { display: flex; flex-wrap: wrap; gap: 12px; }\n.ds-card {\n  background: #fff;\n  border: 1px solid #e5e7eb;\n  border-radius: 8px;\n  padding: 14px 16px;\n  min-width: 260px;\n  flex: 1;\n  max-width: 320px;\n}\n.ds-card-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  margin-bottom: 10px;\n}\n.ds-name { font-size: 15px; font-weight: 700; color: #1d4ed8; }\n.ds-card-body { display: flex; flex-direction: column; gap: 6px; }\n\n/* Metrics editor */\n.tab-selector {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin-bottom: 12px;\n}\n.metrics-editor { background: #fff; border: 1px solid #e5e7eb; border-radius: 8px; padding: 12px; }\n.metrics-chips  { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-bottom: 8px; }\n\n.metric-chip {\n  background: #eff6ff;\n  color: #1d4ed8;\n  font-size: 11px;\n  font-family: monospace;\n  padding: 3px 6px 3px 8px;\n  border-radius: 10px;\n  display: flex;\n  align-items: center;\n  gap: 4px;\n}\n.remove-chip {\n  background: none;\n  color: #93c5fd;\n  font-size: 14px;\n  line-height: 1;\n  padding: 0;\n}\n.remove-chip:hover { color: #1d4ed8; }\n\n.metric-input {\n  border: 1px dashed #bfdbfe;\n  border-radius: 10px;\n  padding: 3px 10px;\n  font-size: 11px;\n  font-family: monospace;\n  width: 140px;\n  background: #f0f9ff;\n}\n.metric-input:focus { border-color: #3b82f6; outline: none; }\n\n.add-metric-btn {\n  background: none;\n  color: #3b82f6;\n  font-size: 12px;\n  padding: 4px 8px;\n}\n.add-metric-btn:hover { text-decoration: underline; }\n\n/* Rules table */\n.rules-table { width: 100%; border-collapse: collapse; font-size: 12px; }\n.rules-table th {\n  background: #f9fafb;\n  text-align: left;\n  padding: 8px 10px;\n  font-size: 11px;\n  font-weight: 600;\n  color: #6b7280;\n  border-bottom: 1px solid #e5e7eb;\n  text-transform: uppercase;\n  letter-spacing: 0.04em;\n}\n.rules-table td { padding: 8px 10px; border-bottom: 1px solid #f3f4f6; vertical-align: middle; }\n.rules-table tr:hover td { background: #f9fafb; }\n.center { text-align: center; }\n.rule-expr { font-size: 10px; color: #6b7280; max-width: 200px; display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n\n/* Shared field styles */\n.field-row {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  font-size: 12px;\n}\n.field-key { color: #6b7280; width: 80px; flex-shrink: 0; font-size: 11px; }\n.field-input {\n  flex: 1;\n  border: 1px solid #e5e7eb;\n  border-radius: 4px;\n  padding: 4px 8px;\n  font-size: 12px;\n  background: #fff;\n}\n.field-input:focus { border-color: #6366f1; outline: none; }\n.field-input--sm  { max-width: 100px; flex: none; }\n.field-input--select { flex: 1; cursor: pointer; }\n.field-code {\n  background: #f3f4f6; padding: 2px 7px; border-radius: 4px;\n  font-size: 11px; color: #374151;\n}\n\n.toggle-label { display: flex; align-items: center; gap: 4px; font-size: 12px; color: #374151; cursor: pointer; }\n\n.empty-state { color: #9ca3af; padding: 20px 0; font-size: 13px; }\n</style>\n"],"sourceRoot":"src/components/user"}]}